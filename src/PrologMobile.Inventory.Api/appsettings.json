{
  "InventoryApi": {
    "BaseUrl": "https://stg.prologmobile.com/",
    "PageSize": 25,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 200,
    "UseJitter": true,
    "AttemptTimeoutMilliseconds": 15000,
    "ExtraPageCap": 3,
    "MaxPages": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
